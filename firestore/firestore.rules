rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(companyId) { return /databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid); }
    function isMember(companyId) { return signedIn() && exists(userDoc(companyId)); }
    function isDirector(companyId) { return isMember(companyId) && get(userDoc(companyId)).data.role == "director"; }

    match /userIndex/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
    }

    match /companies/{companyId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isMember(companyId);
      allow update: if isDirector(companyId);

      match /users/{userId} {
        allow read: if isMember(companyId) || (signedIn() && request.auth.uid == userId);
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.role == "director" &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
        allow update: if isDirector(companyId) || (signedIn() && request.auth.uid == userId);
      }

      match /projects/{projectId} {
        allow read: if isMember(companyId);
        allow create, update: if isDirector(companyId);
        match /{subcollection}/{documentId} {
          allow read: if isMember(companyId);
          allow create, update: if isDirector(companyId);
        }
      }
    }
  }
}
