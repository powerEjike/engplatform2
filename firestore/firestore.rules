rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(companyId) { return /databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid); }
    function isMember(companyId) { return signedIn() && exists(userDoc(companyId)); }
    function role(companyId) { return get(userDoc(companyId)).data.role; }
    function isDirector(companyId) { return isMember(companyId) && role(companyId) == "director"; }
    function isProjectManager(companyId) { return isMember(companyId) && role(companyId) == "project_manager"; }
    function isQs(companyId) { return isMember(companyId) && role(companyId) == "quantity_surveyor"; }
    function isSiteEngineer(companyId) { return isMember(companyId) && role(companyId) == "site_engineer"; }
    function isAssignedEngineer(companyId, projectId) {
      return isSiteEngineer(companyId) && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)).data.siteEngineerId == request.auth.uid;
    }
    function canSubmitSiteUpdate(companyId, projectId) {
      return isDirector(companyId) || isProjectManager(companyId) || isAssignedEngineer(companyId, projectId);
    }

    match /userIndex/{userId} { allow read, create: if signedIn() && request.auth.uid == userId; }
    match /companies/{companyId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isMember(companyId);
      allow update: if isDirector(companyId);
      match /users/{userId} {
        allow read: if isMember(companyId);
        // A newly created company must be able to create its first Director profile.
        // Afterwards, only the Director can add or change team profiles.
        allow create: if signedIn() && request.auth.uid == userId && (get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid || (request.resource.data.inviteId is string && get(/databases/$(database)/documents/companies/$(companyId)/invites/$(request.resource.data.inviteId)).data.active == true && get(/databases/$(database)/documents/companies/$(companyId)/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email && get(/databases/$(database)/documents/companies/$(companyId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role));
        allow update: if isDirector(companyId);
      }
      match /invites/{inviteId} {
        allow create, list: if isDirector(companyId);
        allow get: if signedIn();
      }
      match /projects/{projectId} {
        allow read: if isMember(companyId);
        allow create, update: if isDirector(companyId) || isProjectManager(companyId);
        match /boqItems/{itemId} {
          allow read: if isMember(companyId);
          allow create: if isDirector(companyId) || isQs(companyId);
          allow update: if isDirector(companyId) || isQs(companyId) || (canSubmitSiteUpdate(companyId, projectId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["cumulativeQuantityCompleted"]));
          allow delete: if isDirector(companyId) || isQs(companyId);
        }
        match /boqUploads/{uploadId} { allow read: if isMember(companyId); allow create: if isDirector(companyId) || isQs(companyId); }
        match /activityLog/{eventId} { allow read: if isMember(companyId); allow create: if canSubmitSiteUpdate(companyId, projectId) || isQs(companyId); }
        match /siteReports/{reportId} { allow read: if isMember(companyId); allow create: if canSubmitSiteUpdate(companyId, projectId); }
        match /variations/{variationId} { allow read: if isMember(companyId); allow create: if isProjectManager(companyId) || isDirector(companyId) || isAssignedEngineer(companyId, projectId); allow update: if isQs(companyId) || isProjectManager(companyId) || isDirector(companyId); }
        match /valuations/{valuationId} { allow read: if isMember(companyId); allow create, update: if isQs(companyId) || isDirector(companyId); }
      }
    }
  }
}
