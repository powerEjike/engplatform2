rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(companyId) { return /databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid); }
    function isMember(companyId) { return signedIn() && exists(userDoc(companyId)) && get(userDoc(companyId)).data.active == true; }
    function role(companyId) { return get(userDoc(companyId)).data.role; }
    function isDirector(companyId) { return isMember(companyId) && role(companyId) == "director"; }
    function isVerifiedDirector(companyId) { return isDirector(companyId) && request.auth.token.email_verified == true; }
    function isProjectManager(companyId) { return isMember(companyId) && role(companyId) == "project_manager"; }
    function isQs(companyId) { return isMember(companyId) && role(companyId) == "quantity_surveyor"; }
    function isSiteEngineer(companyId) { return isMember(companyId) && role(companyId) == "site_engineer"; }
    function isAssignedEngineer(companyId, projectId) {
      return isSiteEngineer(companyId) && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)).data.siteEngineerId == request.auth.uid;
    }
    function isAssignedProjectManager(companyId, projectId) {
      return isProjectManager(companyId) && get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)).data.projectManagerId == request.auth.uid;
    }
    function canSubmitSiteUpdate(companyId, projectId) {
      return isDirector(companyId) || isAssignedProjectManager(companyId, projectId) || isAssignedEngineer(companyId, projectId);
    }
    function canAccessProject(companyId, projectId) {
      return isDirector(companyId) || isQs(companyId) || isAssignedProjectManager(companyId, projectId) || isAssignedEngineer(companyId, projectId);
    }
    // This version is deliberately based on the project being read. Firestore
    // can prove the role-filtered list queries used by PM and Site Engineer
    // dashboards (where projectManagerId/siteEngineerId equals the signed-in
    // user's ID), whereas a get() of a dynamic project path cannot be proven
    // for a collection query.
    function canReadProjectListItem(companyId) {
      return isDirector(companyId)
        || isQs(companyId)
        || (isProjectManager(companyId) && resource.data.projectManagerId == request.auth.uid)
        || (isSiteEngineer(companyId) && resource.data.siteEngineerId == request.auth.uid);
    }
    function canAcceptInvite(companyId, inviteId) {
      return signedIn()
        && resource.data.active == true
        && resource.data.expiresAt > request.time
        && resource.data.email == request.auth.token.email
        && request.resource.data.active == false
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active", "acceptedAt", "acceptedBy"])
        && getAfter(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.inviteId == inviteId
        && getAfter(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.role == resource.data.role;
    }

    // An account can only point to a company where its matching team profile exists.
    // This prevents a signed-in user from attaching their index to another workspace.
    match /userIndex/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.companyId is string
        && request.resource.data.keys().hasOnly(["companyId", "createdAt"])
        && (exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)/users/$(userId))
          || getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)/users/$(userId)).data.companyId == request.resource.data.companyId);
    }
    match /companies/{companyId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isMember(companyId);
      allow update: if isVerifiedDirector(companyId);
      match /users/{userId} {
        allow read: if isMember(companyId);
        // A newly created company must be able to create its first Director profile.
        // Afterwards, only the Director can add or change team profiles.
        allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.companyId == companyId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.active == true
          && (get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid
            ? request.resource.data.role == "director"
            : (request.resource.data.inviteId is string
              && get(/databases/$(database)/documents/companies/$(companyId)/invites/$(request.resource.data.inviteId)).data.active == true
              && get(/databases/$(database)/documents/companies/$(companyId)/invites/$(request.resource.data.inviteId)).data.expiresAt > request.time
              && get(/databases/$(database)/documents/companies/$(companyId)/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email
              && get(/databases/$(database)/documents/companies/$(companyId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role));
        allow update: if isVerifiedDirector(companyId);
      }
      match /invites/{inviteId} {
        allow create, list: if isVerifiedDirector(companyId);
        // Invite details are visible only to the invited email or a company Director.
        allow get: if isDirector(companyId) || (signedIn() && resource.data.email == request.auth.token.email);
        allow update: if isDirector(companyId) || canAcceptInvite(companyId, inviteId);
      }
      match /projects/{projectId} {
        // PMs and Site Engineers can list only projects assigned to them.
        // Nested project records retain the project-ID access check below.
        allow read: if canReadProjectListItem(companyId);
        // Directors control commercial details. An assigned PM may allocate a
        // Site Engineer for their own project, but cannot change the contract
        // or replace the Project Manager.
        allow create: if isVerifiedDirector(companyId);
        allow update: if isVerifiedDirector(companyId)
          || (isAssignedProjectManager(companyId, projectId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["siteEngineerId", "siteEngineerName", "assignmentUpdatedAt"])
            && request.resource.data.siteEngineerId is string
            && request.resource.data.siteEngineerName is string
            && get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.resource.data.siteEngineerId)).data.role == "site_engineer"
            && get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.resource.data.siteEngineerId)).data.active == true);
        match /boqItems/{itemId} {
          allow read: if canAccessProject(companyId, projectId);
          allow create: if isVerifiedDirector(companyId) || isQs(companyId);
          allow update: if isVerifiedDirector(companyId) || isQs(companyId) || (canSubmitSiteUpdate(companyId, projectId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["cumulativeQuantityCompleted"]));
          allow delete: if isVerifiedDirector(companyId) || isQs(companyId);
        }
        match /boqUploads/{uploadId} { allow read: if canAccessProject(companyId, projectId); allow create: if isVerifiedDirector(companyId) || isQs(companyId); }
        match /activityLog/{eventId} {
          allow read: if canAccessProject(companyId, projectId);
          allow create: if (canSubmitSiteUpdate(companyId, projectId) || isQs(companyId))
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.actorName == get(userDoc(companyId)).data.name
            && request.resource.data.actorRole == role(companyId)
            && request.resource.data.keys().hasOnly(["action", "summary", "actorId", "actorName", "actorRole", "createdAt"])
            && request.resource.data.action is string
            && request.resource.data.action.size() > 0
            && request.resource.data.action.size() <= 80
            && request.resource.data.summary is string
            && request.resource.data.summary.size() > 0
            && request.resource.data.summary.size() <= 1000
            && request.resource.data.createdAt == request.time;
        }
        match /siteReports/{reportId} {
          allow read: if canAccessProject(companyId, projectId);
          allow create: if canSubmitSiteUpdate(companyId, projectId) && request.resource.data.submittedBy == request.auth.uid;
          allow update: if (isVerifiedDirector(companyId) || isAssignedProjectManager(companyId, projectId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reviewStatus", "reviewedBy", "reviewedAt", "reviewReason"])
            && request.resource.data.reviewStatus in ["reviewed", "queried", "accepted"]
            && request.resource.data.reviewedBy == request.auth.uid
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewReason is string
            && request.resource.data.reviewReason.size() <= 1000;
          match /comments/{commentId} {
            allow read: if canAccessProject(companyId, projectId);
            allow create: if (isVerifiedDirector(companyId) || isQs(companyId) || isAssignedProjectManager(companyId, projectId)) && request.resource.data.authorId == request.auth.uid;
          }
        }
        match /milestones/{milestoneId} { allow read: if canAccessProject(companyId, projectId); allow create, update, delete: if isVerifiedDirector(companyId) || isAssignedProjectManager(companyId, projectId); }
        match /variations/{variationId} { allow read: if canAccessProject(companyId, projectId); allow create: if (isAssignedProjectManager(companyId, projectId) || isVerifiedDirector(companyId) || isAssignedEngineer(companyId, projectId)) && request.resource.data.raisedBy == request.auth.uid; allow update: if isQs(companyId) || isAssignedProjectManager(companyId, projectId) || isVerifiedDirector(companyId); }
        match /valuations/{valuationId} {
          allow read: if canAccessProject(companyId, projectId);
          allow create: if isQs(companyId) || isVerifiedDirector(companyId);
          allow update: if isQs(companyId) || isVerifiedDirector(companyId)
            || (isAssignedProjectManager(companyId, projectId)
              && resource.data.status == "pending_project_manager_review"
              && request.resource.data.status == "pending_director_approval"
              && request.resource.data.recommendedBy == request.auth.uid
              && request.resource.data.recommendedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "recommendedBy", "recommendedAt"]));
        }
        match /projectActions/{actionId} {
          allow read: if canAccessProject(companyId, projectId);
          allow create: if (isVerifiedDirector(companyId) || isAssignedProjectManager(companyId, projectId))
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update: if isVerifiedDirector(companyId) || isAssignedProjectManager(companyId, projectId)
            || (canAccessProject(companyId, projectId)
              && resource.data.assignedTo == request.auth.uid
              && resource.data.status == "open"
              && request.resource.data.status == "complete"
              && request.resource.data.completedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "completedAt"]));
        }
      }
      match /messages/{messageId} {
        allow read: if isMember(companyId);
        allow create: if isMember(companyId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(userDoc(companyId)).data.name
          && request.resource.data.authorRole == role(companyId)
          && request.resource.data.keys().hasOnly(["authorId", "authorName", "authorRole", "message", "createdAt"])
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 1000
          && request.resource.data.createdAt == request.time;
      }
      // Security records are append-only and visible only to Directors.
      match /securityAudit/{auditId} {
        allow read: if isDirector(companyId);
        allow create: if isVerifiedDirector(companyId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorName == get(userDoc(companyId)).data.name
          && request.resource.data.actorRole == "director"
          && request.resource.data.keys().hasOnly(["actorId", "actorName", "actorRole", "action", "entityType", "entityId", "entityName", "before", "after", "createdAt"])
          && request.resource.data.action is string
          && request.resource.data.action.size() > 0
          && request.resource.data.action.size() <= 80
          && request.resource.data.entityType is string
          && request.resource.data.entityType.size() <= 40
          && request.resource.data.entityId is string
          && request.resource.data.entityId.size() <= 128
          && request.resource.data.entityName is string
          && request.resource.data.entityName.size() <= 200
          && request.resource.data.before is map
          && request.resource.data.after is map
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
